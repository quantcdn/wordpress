{
    "name": "quantcdn/wordpress-plugin",
    "description": "QuantCDN integration for WordPress",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.6",
        "php-stubs/wp-cli-stubs": "^2.11",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^10.0",
        "szepeviktor/phpstan-wordpress": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Quant\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Quant\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": false
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=2G",
        "lint:complexity": "phpmd src text phpmd.xml",
        "lint": [
            "@analyse",
            "@lint:complexity"
        ],
        "check": [
            "@lint",
            "@test"
        ]
    }
}
