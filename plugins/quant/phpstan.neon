includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
parameters:
    level: 5
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    paths:
        - src
        - quant.php
        - uninstall.php
    scanFiles:
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
        - vendor/php-stubs/wp-cli-stubs/wp-cli-commands-stubs.php
        - vendor/php-stubs/wp-cli-stubs/wp-cli-i18n-stubs.php
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    ignoreErrors:
        - '#Constant QUANT_[A-Z_]+ not found#'
        - '#Class Red_Item not found#'
        - '#Class Red_Module not found#'
        - '#Call to static method [a-zA-Z_]+\(\) on an unknown class Red_(Item|Module)#'
